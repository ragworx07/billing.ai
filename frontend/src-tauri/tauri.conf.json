{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KKR ERP",
  "version": "1.0.0",
  "identifier": "com.kkr.erp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KKR ERP",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend-dist/kkr-backend": "backend"
    },
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Construction ERP for redevelopment workflow",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MTQ4NTA5RjQ0QjFDOUYKUldTZkhFdjBDWVVVbFhpMGxkWWozcFlPWG1XaTk0cTdjZ0JGVUtlOUpFeS9pU0V3VGlScHlDTEYK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
