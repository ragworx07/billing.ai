# KKR ERP - canonical environment template
# Copy this file to .env at the repository root. Never commit .env.

# Application
APP_NAME=Billing ERP API
API_V1_STR=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info

# Supabase PostgreSQL
# For a desktop/persistent backend on an IPv4 network, use the Supabase
# Session pooler URI from Dashboard > Connect (port 5432), with sslmode=require.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800

# Storage Provider (gdrive / supabase / local)
STORAGE_PROVIDER=gdrive
GDRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id
GDRIVE_TOKEN_FILE=gdrive_token.json
GDRIVE_CREDENTIALS_FILE=client_secret.json
GDRIVE_BACKUP_FOLDER_ID=

# Automated Backup Settings
BACKUP_AUTO_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00
BACKUP_RETENTION_COUNT=7
BACKUP_DESTINATION=gdrive
BACKUP_INCLUDE_DATABASE=true
BACKUP_INCLUDE_FINANCIALS=true
BACKUP_INCLUDE_MANIFEST=true

# Local / uploads folder
LOCAL_STORAGE_DIR=./uploads

# Supabase Storage (legacy / fallback)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_PROJECT_FILES_BUCKET=project-files
SUPABASE_NOTES_BUCKET=note-attachments
SUPABASE_MEDIA_BUCKET=media

# Frontend -> bundled local backend
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Desktop updates. The release build bakes these into the app.
# UPDATE_GITHUB_REPO is owner/name. The release tag is the prefix plus the app version.
UPDATE_GITHUB_REPO=Ragworx/KKR
UPDATE_GITHUB_TAG_PREFIX=v
UPDATE_MANIFEST_NAME=latest.json

# Local/Tauri origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Optional AI search. Leave GROQ_API_KEY blank to use deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
